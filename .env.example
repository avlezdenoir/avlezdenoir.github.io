# Set these in Vercel Project > Settings > Environment Variables.
BOT_HOSTING_API_KEY=bhk_replace_with_your_key
ADMIN_PASSWORD=replace_with_a_long_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters
# Exact URL of your deployed Vercel app, e.g. https://avlez-denoir.vercel.app
APP_ORIGIN=https://your-project.vercel.app
